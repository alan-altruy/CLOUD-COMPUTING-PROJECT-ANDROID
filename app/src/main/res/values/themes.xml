<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme -->
    <color name="splash_bg">#ffffff</color>
    <style name="Theme.ImageSearchEngine" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.ImageSearchEngine.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ImageSearchEngine</item>
    </style>

</resources>